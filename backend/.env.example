DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://business.example.com,https://passenger.example.com
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=hbt
POSTGRES_USER=hbt
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
NRC_ENCRYPTION_KEY=replace-with-a-fernet-key
NRC_BLIND_INDEX_KEY=replace-with-a-separate-long-random-secret
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
PUSH_PROVIDER_BACKEND=apps.notifications.push.DisabledPushProvider
MALWARE_SCAN_COMMAND=clamscan --no-summary
MALWARE_SCAN_REQUIRED=false
MALWARE_SCAN_TIMEOUT_SECONDS=30
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
