DJANGO_DEBUG=false
DJANGO_SECRET_KEY=inject-from-secret-store
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=hbt
POSTGRES_USER=hbt_app
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
NRC_ENCRYPTION_KEY=inject-fernet-key-from-secret-store
NRC_BLIND_INDEX_KEY=inject-separate-key-from-secret-store
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=inject-separate-fernet-key
PUSH_TOKEN_ENCRYPTION_KEY=inject-separate-fernet-key
PUSH_PROVIDER_BACKEND=apps.notifications.push.DisabledPushProvider
MALWARE_SCAN_COMMAND=clamscan --no-summary
MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_TIMEOUT_SECONDS=30
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_TRUST_PROXY_SSL_HEADER=true
API_ANON_RATE=60/min
API_USER_RATE=600/min
